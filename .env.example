# === Bot 配置 ===
BOT_TOKEN=your_bot_token_from_BotFather

# === Telethon 配置 (collector.py 用) ===
API_ID=your_api_id
API_HASH=your_api_hash
PHONE=+8613800000000
PASSWORD=your_telegram_password
SESSION_NAME=collector_session

# === 三个频道配置 ===
# 频道1: 燃魂动漫
CHANNEL_RANHUN_ID=-100xxxxxxxxx
CHANNEL_RANHUN_USERNAME=@ranhun

# 频道2: 每日福利
CHANNEL_MEIRIFULI_ID=-100xxxxxxxxx
CHANNEL_MEIRIFULI_USERNAME=@meirifuli

# 频道3: 优秀电视剧
CHANNEL_YOUXIUDIANSHIJU_ID=-100xxxxxxxxx
CHANNEL_YOUXIUDIANSHIJU_USERNAME=@youxiudianshiju

# === 外部链接 ===
# 搜索群链接
SEARCH_GROUP_LINK=https://t.me/your_search_group
SEARCH_GROUP_NAME=资源搜索互助群

# === 代理配置 (如需翻墙) ===
PROXY_ENABLED=0
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10809
